{
  "name": "teste-cypress-ambev",
  "version": "1.0.0",
  "description": "Testes automatizados de front e API com Cypress (ServeRest)",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:front": "cypress run --spec 'cypress/e2e/front/**/*.feature'",
    "test:api": "cypress run --spec 'cypress/e2e/api/**/*.feature'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizarbventurim/Teste_Cypress_Ambev.git"
  },
  "bugs": {
    "url": "https://github.com/lizarbventurim/Teste_Cypress_Ambev/issues"
  },
  "homepage": "https://github.com/lizarbventurim/Teste_Cypress_Ambev#readme",
  "private": true,
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "cypress": "^16.2.0",
    "cypress-plugin-api": "^2.12.3",
    "esbuild": "^0.28.2"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/support/step_definitions/**/*.js"
    ]
  }
}
